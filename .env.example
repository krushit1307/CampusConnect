VITE_CAPTIVE_PORTAL_TIMEOUT_SECONDS=30
VITE_ISE_SERVER_URL=https://ise.campus.edu:9060
VITE_JWT_SIGNING_KEY=your-secret-signing-key-here
VITE_WIFI_JWT_EXPIRY_MINUTES=480
VITE_MAC_ROTATION_CHECK_INTERVAL=30000
VITE_WIFI_SESSION_STORAGE_KEY=wifi_session
