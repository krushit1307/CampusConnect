# Supabase Edge Function secret used by sync-academic-calendar
ACADEMIC_CALENDAR_ICS_URL=https://university.example.edu/academic-calendar.ics
# Event description TL;DR summarizer Edge Function (#3240)
OPENAI_API_KEY=your_openai_api_key_here
EVENT_SUMMARIZER_MODEL=gpt-4o-mini
EVENT_SUMMARIZER_WEBHOOK_SECRET=your_event_summarizer_webhook_secret_here

SUPABASE_JWT_SECRET=your_supabase_jwt_signing_secret
VITE_OTEL_COLLECTOR_URL=http://localhost:4318/v1/traces
HUGGINGFACE_ACCESS_TOKEN=your_huggingface_access_token_here
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret_here
VITE_TURNSTILE_SITE_KEY=
VITE_SITE_URL=https://campus-connect-ecsoc.vercel.app/
SITE_URL=https://campus-connect-ecsoc.vercel.app/
# Edge Function geo load balancer (edge-router)
# Comma separated "id=url[:weight]" replica nodes (weight defaults to 1)
LB_NODES=us-east=https://us-east-replica.supabase.co:2,eu-west=https://eu-west-replica.supabase.co,ap-south=https://ap-south-replica.supabase.co
# Comma separated "COUNTRY=nodeId" nearest-replica mapping
LB_GEO_MAP=US=us-east,CA=us-east,GB=eu-west,DE=eu-west,IN=ap-south,AU=ap-south
# Secret used to sign the _sv_node affinity cookie (random string)
LB_COOKIE_SECRET=replace_with_a_long_random_string

# Blockchain certificate ledger (#1041) — edge functions certificate-anchor / verify-certificate
# Public site origin used to build certificate proof URLs (e.g. /verify?cert=<id>)
SITE_URL=https://campusconnect.example.com
# Deployed CertificateLedger contract address (Polygon PoS recommended)
CERT_LEDGER_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
# Public or private JSON-RPC endpoint for the chain
CERT_LEDGER_RPC_URL=https://polygon-rpc.com
# Private key of the deployer/owner wallet used to submit anchorDay transactions
CERT_LEDGER_SIGNER_KEY=replace_with_your_private_key
# Chain id used by the anchor worker (137 = Polygon PoS mainnet, 80002 = Amoy testnet)
CERT_LEDGER_CHAIN_ID=137
# Secret used to sign ticket JWTs in the generate-ticket-jwt Edge Function.
# Generate a strong random value: openssl rand -hex 32
TICKET_JWT_SECRET=your_ticket_jwt_secret_here

# PostgreSQL connection string with PgBouncer
# The port is set to 6432 for PgBouncer instead of the default 5432
# ?pgbouncer=true is appended for compatibility (e.g. Prisma)
DATABASE_URL=postgresql://postgres:postgres@localhost:6432/postgres?pgbouncer=true
# AWS Rekognition & Video Processing
AWS_REGION=us-east-1
AWS_S3_BUCKET=campusconnect-media
AWS_REKOGNITION_ROLE_ARN=arn:aws:iam::YOUR_ACCOUNT_ID:role/RekognitionServiceRole
AWS_MEDIACONVERT_ENDPOINT=https://mediaconvert.us-east-1.amazonaws.com
AWS_MEDIACONVERT_ROLE_ARN=arn:aws:iam::YOUR_ACCOUNT_ID:role/MediaConvertServiceRole
AWS_MEDIACONVERT_QUEUE=Default
AWS_SNS_TOPIC_ARN=arn:aws:sns:us-east-1:YOUR_ACCOUNT_ID:video-processing-topic
