{
  "name": "campus-connect",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "prepare": "husky",
    "dev:remote": "vite --config vite.config.events.ts --port 4174",
    "build:analyze": "ANALYZE=true vite build",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "build:verify-css": "vite build && node scripts/verify-tailwind-safelist.mjs",
    "build:remote": "vite build --config vite.config.events.ts",
    "preview": "vite preview",
    "lint": "eslint .",
    "check-i18n": "node scripts/check-i18n.cjs",
    "commitlint": "commitlint --edit",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "test": "node scripts/run-vitest-batches.mjs",
    "test:watch": "vitest --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.config.integration.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "test:visual": "docker-compose -f docker-compose.visual.yml run --rm playwright bash -c \"npm install && npx playwright test e2e/visual.spec.ts\"",
    "test:visual:update": "docker-compose -f docker-compose.visual.yml run --rm playwright bash -c \"npm install && npx playwright test e2e/visual.spec.ts --update-snapshots\"",
    "test:edge": "deno test --allow-env --allow-net --allow-read supabase/functions",
    "auth:verify-jwks": "node scripts/verify-jwks.mjs",
    "test:cypress": "cypress run",
    "test:cypress:open": "cypress open",
    "test:cypress:component": "cypress run --component",
    "test:cypress:component:open": "cypress open --component",
    "typecheck:cypress": "tsc --noEmit -p tsconfig.cypress.json",
    "github:update-labels": "npx tsx scripts/update-labels.ts",
    "github:create-new-issues": "npx tsx scripts/create-new-issues.ts",
    "github:create-frontend-issues": "npx tsx scripts/create-frontend-issues.ts",
    "github:create-backend-issues": "npx tsx scripts/create-backend-issues.ts",
    "github:audit-labels": "npx tsx scripts/audit-labels.ts",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "codegen": "graphql-codegen --config codegen.ts"
  },
